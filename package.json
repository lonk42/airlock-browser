{
  "name": "airlock-browser",
  "productName": "Airlock Browser",
  "version": "1.0.0",
  "description": "Locked-down browser window for one site or remote desktop, with kiosk mode and window-manager key passthrough",
  "homepage": "https://github.com/lonk42/airlock-browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/lonk42/airlock-browser.git"
  },
  "author": "lonk42",
  "license": "GPL-3.0-or-later",
  "main": "app/main.js",
  "desktopName": "airlock-browser.desktop",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.lonk42.airlock-browser",
    "productName": "Airlock Browser",
    "executableName": "airlock-browser",
    "files": [
      "app/**"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "rpm"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "airlock-browser",
          "Name": "Airlock Browser"
        }
      },
      "maintainer": "lonk42"
    },
    "rpm": {
      "packageName": "airlock-browser",
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "publish": null
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "electron-winstaller": false
  }
}
